{
  "name": "finbuddy",
  "version": "0.0.1",
  "private": true,
  "description": "FinBuddy Monorepo - Financial Management & AI Assistant",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=@finbuddy/api",
    "build:web": "npm run build --workspace=@finbuddy/web",
    "test": "npm run test --workspaces --if-present",
    "test:api": "npm run test --workspace=@finbuddy/api",
    "test:api:e2e": "npm run test:e2e --workspace=@finbuddy/api",
    "test:api:eval": "npm run ai:evaluate --workspace=@finbuddy/api",
    "test:ai:evaluation": "npm run ai:evaluate --workspace=@finbuddy/api",
    "test:ai:scenario": "npm run test:api -- test/ai-agent/evaluation/agent-evaluation.spec.ts",
    "test:ai:real": "AI_EVALUATION_REAL_OPENAI=true npm run test:api -- test/ai-agent/evaluation/real-openai-runner.ts",
    "test:web": "npm run test --workspace=@finbuddy/web",
    "test:web:e2e": "npm run test:e2e --workspace=@finbuddy/web",
    "lint": "npm run lint --workspaces --if-present",
    "lint:api": "npm run lint --workspace=@finbuddy/api",
    "lint:web": "npm run lint --workspace=@finbuddy/web",
    "prisma:generate": "npm run prisma:generate --workspace=@finbuddy/api",
    "prisma:validate": "npm run prisma:validate --workspace=@finbuddy/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=@finbuddy/api",
    "prisma:deploy": "npm run prisma:deploy --workspace=@finbuddy/api"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  }
}
