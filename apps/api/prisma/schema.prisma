generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum IdentityProvider {
  GOOGLE
  GITHUB
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
  CASH
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique @db.VarChar(320)
  passwordHash    String     @map("password_hash") @db.VarChar
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  profile       UserProfile?
  identities    UserIdentity[]
  refreshTokens RefreshToken[]
  accounts              Account[]
  categories            Category[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  aiConfirmations       AiConfirmation[]
  aiAuditEvents         AiAuditEvent[]
  aiConversations       AiConversation[]
  memories              AiMemory[]

  @@map("users")
}

model UserProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  fullName  String   @map("full_name") @db.VarChar
  currency  String   @db.Char(3)
  timezone  String   @db.VarChar
  locale    String   @db.VarChar
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model UserIdentity {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  provider       IdentityProvider
  providerUserId String           @map("provider_user_id") @db.VarChar
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("user_identities")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Account {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  name      String      @db.VarChar
  type      AccountType
  balance   Decimal     @default(0) @db.Decimal(19, 4)
  currency  String      @default("BRL") @db.Char(3)
  color     String      @db.VarChar(7)
  isActive  Boolean     @default(true) @map("is_active")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  transfersFrom         Transfer[]             @relation("TransfersFrom")
  transfersTo           Transfer[]             @relation("TransfersTo")
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@map("accounts")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionSource {
  MANUAL
  IMPORT
  SYSTEM
}

model Transaction {
  id                     String                @id @default(uuid()) @db.Uuid
  accountId              String                @map("account_id") @db.Uuid
  transferId             String?               @map("transfer_id") @db.Uuid
  categoryId             String?               @map("category_id") @db.Uuid
  recurringTransactionId String?               @map("recurring_transaction_id") @db.Uuid
  recurringOccurrence    DateTime?             @map("recurring_occurrence") @db.Date
  type                   TransactionType
  amount                 Decimal               @db.Decimal(19, 4)
  description            String?               @db.VarChar
  source                 TransactionSource     @default(MANUAL)
  transactionAt          DateTime              @map("transaction_at") @db.Timestamptz
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  account              Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transfer             Transfer?             @relation(fields: [transferId], references: [id], onDelete: Cascade)
  category             Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  recurringTransaction RecurringTransaction? @relation(fields: [recurringTransactionId], references: [id], onDelete: SetNull)

  @@unique([recurringTransactionId, recurringOccurrence])
  @@index([accountId])
  @@index([transferId])
  @@index([categoryId])
  @@index([recurringTransactionId])
  @@index([transactionAt])
  @@index([accountId, transactionAt(sort: Desc)])
  @@index([categoryId, transactionAt])
  @@map("transactions")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  name      String       @db.VarChar(100)
  type      CategoryType
  icon      String?      @db.VarChar(50)
  color     String?      @db.VarChar(7)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]

  @@index([userId])
  @@map("categories")
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Transfer {
  id            String   @id @default(uuid()) @db.Uuid
  fromAccountId String   @map("from_account_id") @db.Uuid
  toAccountId   String   @map("to_account_id") @db.Uuid
  amount        Decimal  @db.Decimal(19, 4)
  transactionAt DateTime @map("transaction_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  fromAccount  Account       @relation("TransfersFrom", fields: [fromAccountId], references: [id], onDelete: Cascade)
  toAccount    Account       @relation("TransfersTo", fields: [toAccountId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([fromAccountId])
  @@index([toAccountId])
  @@index([transactionAt])
  @@index([fromAccountId, transactionAt])
  @@index([toAccountId, transactionAt])
  @@map("transfers")
}

model Budget {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  amount     Decimal  @db.Decimal(19, 4)
  month      DateTime @db.Date
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryId, month])
  @@index([userId])
  @@index([categoryId])
  @@index([month])
  @@index([userId, month])
  @@map("budgets")
}

model RecurringTransaction {
  id             String              @id @default(uuid()) @db.Uuid
  userId         String              @map("user_id") @db.Uuid
  accountId      String              @map("account_id") @db.Uuid
  categoryId     String?             @map("category_id") @db.Uuid
  type           TransactionType
  amount         Decimal             @db.Decimal(19, 4)
  description    String?             @db.VarChar
  frequency      RecurrenceFrequency
  startDate      DateTime            @map("start_date") @db.Date
  nextOccurrence DateTime            @map("next_occurrence") @db.Date
  endDate        DateTime?           @map("end_date") @db.Date
  isActive       Boolean             @default(true) @map("is_active")
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  @@index([userId])
  @@index([accountId])
  @@index([categoryId])
  @@index([nextOccurrence])
  @@index([userId, isActive])
  @@index([isActive, nextOccurrence])
  @@map("recurring_transactions")
}

enum AiConfirmationStatus {
  PENDING
  CONSUMED
  EXPIRED
  CANCELLED
}

model AiConfirmation {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  requestId     String?              @map("request_id") @db.VarChar(64)
  aiRequestId   String?              @map("ai_request_id") @db.VarChar(64)
  toolName      String               @map("tool_name") @db.VarChar(100)
  argumentsJson Json                 @map("arguments_json")
  status        AiConfirmationStatus @default(PENDING)
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  expiresAt     DateTime             @map("expires_at") @db.Timestamptz
  consumedAt    DateTime?            @map("consumed_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("ai_confirmations")
}

model AiAuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  requestId      String   @map("request_id") @db.VarChar(64)
  aiRequestId    String?  @map("ai_request_id") @db.VarChar(64)
  eventType      String   @map("event_type") @db.VarChar(64)
  toolName       String?  @map("tool_name") @db.VarChar(64)
  confirmationId String?  @map("confirmation_id") @db.Uuid
  status         String   @map("status") @db.VarChar(32)
  riskLevel      String?  @map("risk_level") @db.VarChar(16)
  metadata       Json?    @map("metadata")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([aiRequestId])
  @@index([confirmationId])
  @@index([createdAt])
  @@map("ai_audit_events")
}

enum ConversationMessageRole {
  USER
  ASSISTANT
}

model AiConversation {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String?  @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user     User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages AiConversationMessage[]

  @@index([userId])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("ai_conversations")
}

model AiConversationMessage {
  id             String                  @id @default(uuid()) @db.Uuid
  conversationId String                  @map("conversation_id") @db.Uuid
  role           ConversationMessageRole
  content        String                  @db.VarChar(4000)
  sequenceNumber Int                     @map("sequence_number")
  createdAt      DateTime                @default(now()) @map("created_at") @db.Timestamptz

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, sequenceNumber])
  @@index([conversationId, createdAt])
  @@map("ai_conversation_messages")
}

enum AiMemoryType {
  PREFERENCE
  FINANCIAL_GOAL
  GENERAL_CONTEXT
}

model AiMemory {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  type      AiMemoryType
  key       String       @db.VarChar(100)
  value     String       @db.VarChar(1000)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, key])
  @@index([userId])
  @@index([userId, type])
  @@map("ai_memories")
}


