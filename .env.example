POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finbuddy
PORT=3000
LOG_LEVEL=info

# Environment & Production Configuration
NODE_ENV=development
SWAGGER_ENABLED=true

JWT_SECRET=your_jwt_secret_here
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finbuddy"

# Recurring Transaction Automation Scheduler
# Set to 'true' to enable background recurring transaction execution scheduler, or 'false' to disable.
RECURRING_TRANSACTION_AUTOMATION_ENABLED=true

# Standard 5-field cron expression for recurring execution check (default: every minute).
RECURRING_TRANSACTION_AUTOMATION_CRON=* * * * *

# Rate Limiting & Abuse Protection
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_AUTH_LIMIT=10

# AI Agent Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_MS=30000

